# GitHub Personal Access Token (classic token with no scopes for public repos, 'repo' scope for private)
GITHUB_TOKEN=ghp_your_token_here

# OPTION 1: Slack Bot Token (Recommended to auto-create separate channels per repo)
# Scopes needed on your Slack App: channels:manage, channels:read, channels:join, chat:write
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# OPTION 2: Single Slack or Discord Webhook URL (all issues posted to one channel)
WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
